@page "/query"
@rendermode InteractiveServer
@using MovieManager.Blazor.Services
@using MovieManager.Blazor.Models
@inject McpApiClient McpClient

<PageTitle>Consultas - MovieManager</PageTitle>

<div class="query-container">

    <div class="query-header">
        <h1>🔍 Consultas en Lenguaje Natural</h1>
        <p>Pregunta sobre películas en español o inglés</p>
    </div>

    @if (!isServerHealthy)
    {
        <div class="alert alert-danger">
            <strong>⚠️ Error:</strong> El servidor MCP no está disponible en http://localhost:5001
            <br />
            <small>Asegúrate de que el servidor está corriendo: <code>cd Backend/MovieManager.MCP && dotnet run</code></small>
        </div>
    }
    else
    {
        <div class="load-data-section">
            <button class="btn btn-secondary" @onclick="LoadTestData" disabled="@isLoading">
                @if (isLoadingData)
                {
                    <span>⏳ Cargando...</span>
                }
                else
                {
                    <span>📥 Cargar 5 películas de prueba</span>
                }
            </button>
            
            <button class="btn btn-primary" @onclick="LoadFullDataset" disabled="@isLoading">
                @if (isLoadingFullDataset)
                {
                    <span>⏳ Cargando dataset...</span>
                }
                else
                {
                    <span>📦 Cargar dataset completo (1000 películas)</span>
                }
            </button>
            
            @if (!string.IsNullOrEmpty(loadDataMessage))
            {
                <span class="load-message">@loadDataMessage</span>
            }
        </div>

        <div class="query-form">
            <div class="input-group">
                <input type="text" 
                       class="form-control query-input" 
                       placeholder="Ej: películas de Nolan, películas de ciencia ficción con más de 8.5 de rating..." 
                       @bind="queryText"
                       @onkeydown="HandleKeyPress"
                       disabled="@isLoading" />
                <button class="btn btn-primary" @onclick="ExecuteQuery" disabled="@(isLoading || string.IsNullOrWhiteSpace(queryText))">
                    @if (isLoading)
                    {
                        <span>⏳ Procesando...</span>
                    }
                    else
                    {
                        <span>🚀 Consultar</span>
                    }
                </button>
            </div>
        </div>

        @if (queryResponse != null)
        {
            <div class="results-section">
                <div class="results-header">
                    <div class="result-info">
                        <span class="badge @(queryResponse.Source == "rule" ? "badge-rule" : "badge-llm")">
                            @(queryResponse.Source == "rule" ? "🔧 Reglas" : "🤖 IA (LLM)")
                        </span>
                        <span class="result-count">📊 @queryResponse.Count resultado(s)</span>
                    </div>
                    @if (queryResponse.Source == "llm" && !string.IsNullOrEmpty(queryResponse.Message))
                    {
                        <div class="linq-code">
                            <small>🧠 LINQ:</small>
                            <code>@queryResponse.Message.Replace("Búsqueda con IA. LINQ: ", "")</code>
                        </div>
                    }
                </div>

                <div class="action-buttons">
                    <button class="btn btn-reset" @onclick="ClearResults">
                        🔄 Nueva Consulta
                    </button>
                </div>

                @if (queryResponse.Count == 0)
                {
                    <div class="no-results">
                        <p>❌ No se encontraron películas con esos criterios.</p>
                    </div>
                }
                else
                {
                    <div class="movies-grid">
                        @foreach (var movie in queryResponse.Results)
                        {
                            <div class="movie-card">
                                <div class="movie-header">
                                    <h3>🎥 @movie.Title</h3>
                                    <span class="movie-year">(@movie.Year)</span>
                                </div>
                                <div class="movie-details">
                                    <div class="detail-row">
                                        <span class="label">📂 Género:</span>
                                        <span class="value">@movie.Genre</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="label">⭐ Rating:</span>
                                        <span class="value rating">@movie.Rating/10</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="label">🎬 Director:</span>
                                        <span class="value">@movie.Director</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="label">⏱️ Duración:</span>
                                        <span class="value">@movie.Runtime min</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(movie.Overview))
                                {
                                    <div class="movie-overview">
                                        <p>@movie.Overview</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string queryText = "";
    private QueryResponse? queryResponse;
    private bool isLoading = false;
    private bool isLoadingData = false;
    private bool isServerHealthy = true;
    private string loadDataMessage = "";
    private bool isLoadingFullDataset = false;

    protected override async Task OnInitializedAsync()
    {
        isServerHealthy = await McpClient.CheckHealthAsync();
    }

    private async Task LoadTestData()
    {
        isLoadingData = true;
        loadDataMessage = "";
        StateHasChanged();

        loadDataMessage = await McpClient.LoadTestDataAsync();

        isLoadingData = false;
        StateHasChanged();
    }

    private async Task LoadFullDataset()
    {
        isLoadingFullDataset = true;
        loadDataMessage = "";
        StateHasChanged();

        loadDataMessage = await McpClient.LoadFullDatasetAsync();

        isLoadingFullDataset = false;
        StateHasChanged();
    }

    private async Task ExecuteQuery()
    {
        if (string.IsNullOrWhiteSpace(queryText)) return;

        isLoading = true;
        queryResponse = null;
        StateHasChanged();

        queryResponse = await McpClient.QueryAsync(queryText);

        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(queryText) && !isLoading)
        {
            await ExecuteQuery();
        }
    }

    private void ClearResults()
    {
        queryText = "";
        queryResponse = null;
        loadDataMessage = "";
        StateHasChanged();
    }
}

<style>
    .query-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .query-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .query-header h1 {
        color: #333;
        margin-bottom: 0.5rem;
    }

    .query-header p {
        color: #666;
        font-size: 1.1rem;
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .load-data-section {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        justify-content: center;
    }

    .load-message {
        color: #28a745;
        font-weight: 500;
    }

    .query-form {
        margin-bottom: 3rem;
    }

    .input-group {
        display: flex;
        gap: 1rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .query-input {
        flex: 1;
        padding: 1rem;
        font-size: 1.1rem;
        border: 2px solid #ddd;
        border-radius: 8px;
        transition: border-color 0.3s ease;
    }

    .query-input:focus {
        outline: none;
        border-color: #667eea;
    }

    .btn {
        padding: 1rem 2rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn-reset {
        background: #6c757d;
        color: white;
    }

    .btn-reset:hover:not(:disabled) {
        background: #5a6268;
        transform: translateY(-2px);
    }

    .results-section {
        margin-top: 3rem;
    }

    .results-header {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .result-info {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1rem;
    }

    .badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .badge-rule {
        background: #28a745;
        color: white;
    }

    .badge-llm {
        background: #667eea;
        color: white;
    }

    .result-count {
        color: #666;
        font-weight: 500;
    }

    .linq-code {
        background: #2d2d2d;
        color: #f8f8f2;
        padding: 1rem;
        border-radius: 6px;
        font-family: 'Courier New', monospace;
        overflow-x: auto;
    }

    .linq-code small {
        color: #a0a0a0;
        display: block;
        margin-bottom: 0.5rem;
    }

    .linq-code code {
        color: #f8f8f2;
    }

    .action-buttons {
        margin-bottom: 2rem;
        text-align: center;
    }

    .no-results {
        text-align: center;
        padding: 3rem;
        color: #666;
        font-size: 1.2rem;
    }

    .movies-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 2rem;
    }

    .movie-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .movie-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.15);
    }

    .movie-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f0f0f0;
    }

    .movie-header h3 {
        color: #667eea;
        font-size: 1.3rem;
        margin: 0;
        flex: 1;
    }

    .movie-year {
        color: #999;
        font-size: 1.1rem;
    }

    .movie-details {
        margin-bottom: 1rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #f5f5f5;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .label {
        color: #666;
        font-weight: 500;
    }

    .value {
        color: #333;
        font-weight: 600;
    }

    .value.rating {
        color: #ffa500;
    }

    .movie-overview {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 2px solid #f0f0f0;
    }

    .movie-overview p {
        color: #666;
        line-height: 1.6;
        font-style: italic;
    }
</style>